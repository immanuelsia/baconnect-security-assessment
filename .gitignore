# =============================================================================
# .gitignore — baconnect-security-assessment
# =============================================================================

# ── RESULTS & OUTPUT ──────────────────────────────────────────────────────────
# All test output files are excluded — results may contain sensitive data
# such as server responses, reflected payloads, or application internals.
results/
!results/.gitkeep

# ── SENSITIVE FILES ───────────────────────────────────────────────────────────
# Raw cookie captures — may contain real session tokens
C5_cookies.txt
*_cookies.txt

# Raw test result files generated during assessment
C3_advanced_results.txt
C7_results.txt
C8_results.txt
*_results.txt

# ── WORDLIST OUTPUTS ──────────────────────────────────────────────────────────
# Generated by c3_generate_wordlists.sh — keep only the generator script
# Payload files in payloads/ are committed intentionally (no sensitive data)
C3_users.txt
C3_passes.txt

# ── ENVIRONMENT & SECRETS ────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets/

# ── OS & EDITOR ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── PYTHON ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
